#6. sum of numbers from 10 to 25 and above list
numbers_list = []
total_sum = 0
for i range(10, 26):
    numbers_list.append(i)
    total_sum += i
print("list of numbers:", numbers_list)
print("sum:", total_sum)

#7. multiplication table of a number
num = int(input("Enter a number: "))
for i in range(1, 11):
    print(f"{num} x {i} = {num * i}")

#8. factorial 
num = int(input("Enter a number: "))
factorial = 1
for i range(1, num + 1):
    factorial *= i
    print(f"Factorial of{num} is {factorial}")

#9. fibonacci 
n = int(input("Enter number of terms: "))
a, b = 0, 1
for _ in range(n)
    print(a, end=" ")
    a, b = b, a + b
print()

#10. reverse a string
text = input("Enter a string: ")
reversed_text = ""
for char in text:
    reversed_text = char + reversed_text
print("Reversed string:", reversed_text)

#11. count vowels in a string
text = input("Enter a string: ")
vowels = "aeiouAEIOU"
count = 0

for char in text:
    if char in vowels:
        count += 1

print("Number of vowels:", count)
str1 = input("Enter the line: ")  # If input is "82"
count = 0
for i in str1:
    if i in "aeiouAEIOU":
        count += 1
print("Number of vowels:", count)  # Output will be 0
